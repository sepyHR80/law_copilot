# Application Settings
APP_NAME=Law Copilot
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database Settings (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://law_copilot:law_copilot@localhost:5432/law_copilot

# MinIO / Object Storage Settings
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=law_copilot
MINIO_SECRET_KEY=law_copilot_password
MINIO_SECURE=false
MINIO_BUCKET_NAME=law-copilot-documents
MAX_DOCUMENT_SIZE_BYTES=10485760

# Free Persian Embedding & LLM via Google AI Studio (Recommended for Zero Cost)
# Get a free API key at: https://aistudio.google.com/app/apikey
EMBEDDING_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_API_KEY=your-google-ai-studio-api-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=50

# Free Persian LLM via Google AI Studio
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-google-ai-studio-api-key
LLM_MODEL=gemini-flash-latest
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.0

# Reranker Settings (Set to false for low-memory environments like Render 512MB free tier)
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
