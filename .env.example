# Application Settings
APP_NAME=Law Copilot
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database Settings (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://law_copilot:law_copilot@localhost:5432/law_copilot

# MinIO / Object Storage Settings
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=law_copilot
MINIO_SECRET_KEY=law_copilot_password
MINIO_SECURE=false
MINIO_BUCKET_NAME=law-copilot-documents
MAX_DOCUMENT_SIZE_BYTES=10485760

# Embedding Service (OpenAI-compatible / LiteLLM Proxy)
EMBEDDING_ENDPOINT=http://localhost:4000/v1
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=100
